    "description": "A Discord music bot powered by Lavalink",
    "main": "src/app.js",
    "type": "commonjs",
    "scripts": {
        "start": "node ./src/app.js",
        "dev": "nodemon ./src/app.js",
        "pm2": "pm2 start ./src/app.js && pm2 monit",
