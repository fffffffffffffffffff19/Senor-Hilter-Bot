        "sequelize": "^6.37.8",
        "sqlite3": "^6.0.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10"
